diff --git a/ports/raspberrypi/common-hal/picodvi/hdmi_audio.c.inc b/ports/raspberrypi/common-hal/picodvi/hdmi_audio.c.inc
new file mode 100644
index 0000000000000000000000000000000000000000..34ce0b620ff6c38cf44195c17db62d4baeca561d
--- /dev/null
+++ b/ports/raspberrypi/common-hal/picodvi/hdmi_audio.c.inc
@@ -0,0 +1,272 @@
+// Experimental fixed-32-kHz mono HDMI PCM transport for the RP2350 picodvi owner.
+// No interrupt-time allocation, sample conversion, packet encoding, or Python callbacks.
+// SPDX-License-Identifier: MIT
+#include "hardware/clocks.h"
+#include "hardware/sync.h"
+#include "common-hal/picodvi/hdmi_packet.c.inc"
+
+#define HDMI_RATE 32000u
+#define HDMI_MAX_PACKETS 180u
+#define HDMI_LINE_WORDS 60u
+#define HDMI_AUDIO_BANKS 2
+
+typedef struct {
+    uint32_t *commands;
+    uint32_t (*lines)[HDMI_LINE_WORDS];
+    volatile uint32_t samples;
+    volatile uint32_t order;
+    volatile bool ready;
+} hdmi_audio_bank_t;
+
+typedef struct {
+    hdmi_audio_bank_t bank[HDMI_AUDIO_BANKS];
+    volatile int active;
+    uint32_t next_order;
+    uint32_t pixel_clock;
+    uint64_t phase;
+    int channel_frame;
+} hdmi_audio_state_t;
+
+static uint32_t hdmi_acr_line[HDMI_LINE_WORDS];
+static uint32_t hdmi_info_line[HDMI_LINE_WORDS];
+static uint32_t hdmi_avi_line[HDMI_LINE_WORDS];
+static uint32_t hdmi_header_lengths[3];
+
+static uint32_t hdmi_build_line(uint32_t *p, const hstx_data_island_t *island, bool vsync, bool active) {
+    uint32_t *start = p;
+    uint32_t h0 = vsync ? SYNC_V0_H0 : SYNC_V1_H0;
+    uint32_t h1 = vsync ? SYNC_V0_H1 : SYNC_V1_H1;
+    uint32_t preamble = (h0 & 0x3ff) | (TMDS_CTRL_01 << 10) | (TMDS_CTRL_01 << 20);
+    *p++ = HSTX_CMD_RAW_REPEAT | MODE_640_H_FRONT_PORCH;
+    *p++ = h1;
+    *p++ = HSTX_CMD_NOP;
+    *p++ = HSTX_CMD_RAW_REPEAT | 8;
+    *p++ = preamble;
+    *p++ = HSTX_CMD_NOP;
+    *p++ = HSTX_CMD_RAW | HSTX_DATA_ISLAND_WORDS;
+    memcpy(p, island->words, sizeof(island->words));
+    p += HSTX_DATA_ISLAND_WORDS;
+    *p++ = HSTX_CMD_NOP;
+    *p++ = HSTX_CMD_RAW_REPEAT | (MODE_640_H_SYNC_WIDTH - 8 - HSTX_DATA_ISLAND_WORDS);
+    *p++ = h0;
+    *p++ = HSTX_CMD_NOP;
+    if (active) {
+        *p++ = HSTX_CMD_RAW_REPEAT | (MODE_640_H_BACK_PORCH - 10);
+        *p++ = h1;
+        *p++ = HSTX_CMD_NOP;
+        *p++ = HSTX_CMD_RAW_REPEAT | 8;
+        *p++ = (h1 & 0x3ff) | (TMDS_CTRL_01 << 10) | (TMDS_CTRL_00 << 20);
+        *p++ = HSTX_CMD_NOP;
+        *p++ = HSTX_CMD_RAW_REPEAT | 2;
+        *p++ = 0x2ccu | (0x133u << 10) | (0x2ccu << 20);
+        *p++ = HSTX_CMD_TMDS | MODE_640_H_ACTIVE_PIXELS;
+    } else {
+        *p++ = HSTX_CMD_RAW_REPEAT | (MODE_640_H_BACK_PORCH + MODE_640_H_ACTIVE_PIXELS);
+        *p++ = h1;
+        *p++ = HSTX_CMD_NOP;
+    }
+    return p - start;
+}
+
+static void hdmi_init_headers(void) {
+    hstx_packet_t packet;
+    hstx_data_island_t island;
+    uint32_t pixel_clock = clock_get_hz(clk_hstx) / 5;
+    uint32_t cts = ((uint64_t)pixel_clock * 4096 + (128 * HDMI_RATE / 2)) / (128 * HDMI_RATE);
+    hstx_packet_set_acr(&packet, 4096, cts);
+    hstx_encode_data_island(&island, &packet, true, true);
+    hdmi_header_lengths[0] = hdmi_build_line(hdmi_acr_line, &island, true, false);
+    hstx_packet_set_audio_infoframe(&packet, HDMI_RATE, 2, 16);
+    hstx_encode_data_island(&island, &packet, true, true);
+    hdmi_header_lengths[1] = hdmi_build_line(hdmi_info_line, &island, true, false);
+    // Unspecified VIC: preserve CircuitPython's existing 625-line timing.
+    hstx_packet_set_avi_infoframe(&packet, 0, 0);
+    hstx_encode_data_island(&island, &packet, false, true);
+    hdmi_header_lengths[2] = hdmi_build_line(hdmi_avi_line, &island, false, false);
+}
+
+static void hdmi_free_audio(picodvi_framebuffer_obj_t *self) {
+    hdmi_audio_state_t *audio = self->hdmi_audio;
+    if (!audio) {
+        return;
+    }
+    self->hdmi_audio = NULL;
+    for (int i = 0; i < HDMI_AUDIO_BANKS; i++) {
+        if (audio->bank[i].commands) {
+            port_free(audio->bank[i].commands);
+        }
+        if (audio->bank[i].lines) {
+            port_free(audio->bank[i].lines);
+        }
+    }
+    port_free(audio);
+}
+
+static bool hdmi_internal(const void *ptr) {
+    return ptr && (((uintptr_t)ptr & 0xf0000000) == 0x20000000);
+}
+
+static void hdmi_allocate_audio(picodvi_framebuffer_obj_t *self) {
+    if (self->hdmi_audio) {
+        return;
+    }
+    hdmi_audio_state_t *audio = port_malloc(sizeof(*audio), true);
+    if (!audio) {
+        m_malloc_fail(sizeof(*audio));
+    }
+    memset(audio, 0, sizeof(*audio));
+    audio->active = -1;
+    audio->pixel_clock = clock_get_hz(clk_hstx) / 5;
+    // No state is published to the ISR until every DMA source is ready.
+    for (int i = 0; i < HDMI_AUDIO_BANKS; i++) {
+        audio->bank[i].commands = port_malloc(self->dma_commands_len * sizeof(uint32_t), true);
+        audio->bank[i].lines = port_malloc(HDMI_MAX_PACKETS * HDMI_LINE_WORDS * sizeof(uint32_t), true);
+        if (!hdmi_internal(audio->bank[i].commands) || !hdmi_internal(audio->bank[i].lines)) {
+            // Temporarily attach only for common cleanup. No bank is ready.
+            self->hdmi_audio = audio;
+            hdmi_free_audio(self);
+            m_malloc_fail(HDMI_MAX_PACKETS * HDMI_LINE_WORDS * sizeof(uint32_t));
+        }
+    }
+    __dmb();
+    self->hdmi_audio = audio;
+}
+
+// Called at frame boundary only; old DMA frame has completed.
+static uint32_t *hdmi_next_frame(picodvi_framebuffer_obj_t *self) {
+    hdmi_audio_state_t *audio = self->hdmi_audio;
+    if (!audio) {
+        return self->dma_commands;
+    }
+    if (audio->active >= 0) {
+        audio->bank[audio->active].samples = 0;
+        audio->active = -1;
+    }
+    int next = -1;
+    for (int i = 0; i < HDMI_AUDIO_BANKS; i++) {
+        if (audio->bank[i].ready && (next < 0 ||
+            (int32_t)(audio->bank[i].order - audio->bank[next].order) < 0)) {
+            next = i;
+        }
+    }
+    if (next >= 0) {
+        audio->active = next;
+        audio->bank[next].ready = false;
+        return audio->bank[next].commands;
+    }
+    // Empty means null intervals, never repeat the previous speech frame.
+    return self->dma_commands;
+}
+
+size_t common_hal_picodvi_framebuffer_audio_write(picodvi_framebuffer_obj_t *self, const uint8_t *pcm, size_t length, uint32_t sample_rate) {
+    if (sample_rate != HDMI_RATE || self->output_width != 640) {
+        mp_raise_ValueError(MP_ERROR_TEXT("HDMI audio needs 640-wide output and 32000 Hz PCM"));
+    }
+    if (length & 1) {
+        mp_raise_ValueError(MP_ERROR_TEXT("PCM16 needs an even byte count"));
+    }
+    if (!length) {
+        return 0;
+    }
+    hdmi_allocate_audio(self);
+    hdmi_audio_state_t *audio = self->hdmi_audio;
+    if (clock_get_hz(clk_hstx) / 5 != audio->pixel_clock) {
+        mp_raise_RuntimeError(MP_ERROR_TEXT("HSTX clock changed during audio"));
+    }
+    int bank_index = -1;
+    // Read active + ready atomically: an IRQ can promote a ready bank to active
+    // between these two observations. Once selected, an unready bank cannot be
+    // taken by the ISR until this writer publishes it below.
+    uint32_t irq_state = save_and_disable_interrupts();
+    for (int i = 0; i < HDMI_AUDIO_BANKS; i++) {
+        if (audio->active != i && !audio->bank[i].ready) {
+            bank_index = i;
+            break;
+        }
+    }
+    restore_interrupts(irq_state);
+    if (bank_index < 0) {
+        return 0;
+    }
+    hdmi_audio_bank_t *bank = &audio->bank[bank_index];
+    memcpy(bank->commands, self->dma_commands, self->dma_commands_len * sizeof(uint32_t));
+    size_t command_word = 0;
+    size_t samples_read = 0;
+    unsigned packets = 0;
+    size_t available = length / 2;
+    bool doubled = self->output_width != self->width;
+    size_t command_size = doubled ? 4 : 2;
+    const size_t active_start = MODE_640_V_SYNC_WIDTH + MODE_640_V_BACK_PORCH;
+    const size_t active_end = active_start + MODE_640_V_ACTIVE_LINES;
+    const uint64_t packet_period = (uint64_t)audio->pixel_clock * 4;
+    for (size_t line = 0; line < MODE_640_V_TOTAL_LINES; line++) {
+        bool active = line >= active_start && line < active_end;
+        audio->phase += (uint64_t)HDMI_RATE * 800;
+        if (line >= 3 && audio->phase >= packet_period) {
+            audio->phase -= packet_period;
+            if (samples_read < available) {
+                if (packets >= HDMI_MAX_PACKETS) {
+                    mp_raise_RuntimeError(MP_ERROR_TEXT("HDMI audio timing exceeds bank capacity"));
+                }
+                audio_sample_t samples[4] = {{0}};
+                size_t count = available - samples_read;
+                if (count > 4) {
+                    count = 4;
+                }
+                for (size_t j = 0; j < count; j++) {
+                    size_t offset = (samples_read + j) * 2;
+                    int16_t sample = (int16_t)((uint16_t)pcm[offset] | ((uint16_t)pcm[offset + 1] << 8));
+                    samples[j].left = sample;
+                    samples[j].right = sample;
+                }
+                hstx_packet_t packet;
+                hstx_data_island_t island;
+                audio->channel_frame = hstx_packet_set_audio_samples(&packet, samples, count, audio->channel_frame);
+                hstx_encode_data_island(&island, &packet, false, true);
+                uint32_t words = hdmi_build_line(bank->lines[packets], &island, false, active);
+                size_t entry = command_word + (doubled ? 2 : 0);
+                bank->commands[entry] = words;
+                bank->commands[entry + 1] = (uintptr_t)bank->lines[packets];
+                packets++;
+                samples_read += count;
+            }
+        }
+        command_word += command_size * (active ? 2 : 1);
+    }
+    bank->samples = samples_read;
+    bank->order = audio->next_order++;
+    __dmb();
+    bank->ready = true;
+    return samples_read * 2;
+}
+
+size_t common_hal_picodvi_framebuffer_get_audio_pending(picodvi_framebuffer_obj_t *self) {
+    hdmi_audio_state_t *audio = self->hdmi_audio;
+    if (!audio) {
+        return 0;
+    }
+    uint32_t irq_state = save_and_disable_interrupts();
+    size_t count = 0;
+    for (int i = 0; i < HDMI_AUDIO_BANKS; i++) {
+        if (audio->bank[i].ready || audio->active == i) {
+            count += audio->bank[i].samples;
+        }
+    }
+    restore_interrupts(irq_state);
+    return count;
+}
+
+void common_hal_picodvi_framebuffer_audio_stop(picodvi_framebuffer_obj_t *self) {
+    hdmi_audio_state_t *audio = self->hdmi_audio;
+    if (!audio) {
+        return;
+    }
+    uint32_t irq_state = save_and_disable_interrupts();
+    for (int i = 0; i < HDMI_AUDIO_BANKS; i++) {
+        audio->bank[i].ready = false;
+        if (audio->active != i) {
+            audio->bank[i].samples = 0;
+        }
+    }
+    restore_interrupts(irq_state);
+}
diff --git a/ports/raspberrypi/common-hal/picodvi/hdmi_packet.c.inc b/ports/raspberrypi/common-hal/picodvi/hdmi_packet.c.inc
