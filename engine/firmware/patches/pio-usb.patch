+static int __no_inline_not_in_flash_func(usb_iso_ring_transaction)(pio_port_t *pp,
+                                      endpoint_t *ep, pio_usb_iso_ring_t *ring) {
+  uint32_t const started = get_time_us_32();
+  pio_usb_bus_prepare_receive(pp);
+  pio_usb_bus_send_token(pp, USB_PID_IN, ep->dev_addr, ep->ep_num);
+  pio_usb_bus_start_receive(pp);
+  int const len = pio_usb_bus_receive_packet_and_handshake_limit(pp, 0, ep->size);
+  iso_stats_begin(ring);
+  if (ring->stats.polls) {
+    uint32_t const gap = started - ring->last_poll_us;
+    if (gap > ring->stats.max_poll_gap_us) {
+      ring->stats.max_poll_gap_us = gap;
+    }
+  }
+  ring->last_poll_us = started;
+  ring->stats.polls++;
