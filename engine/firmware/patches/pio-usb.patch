+// These helpers run only on the host-owner core, never the VM core.
+static __always_inline void iso_stats_begin(pio_usb_iso_ring_t *ring) {
+  ring->stats_seq++;
+  __dmb();
+}
+
+static __always_inline void iso_stats_end(pio_usb_iso_ring_t *ring) {
+  __dmb();
+  ring->stats_seq++;
+}
+
+static void __no_inline_not_in_flash_func(iso_detach)(endpoint_t *ep, bool disconnected) {
+  pio_usb_iso_ring_t *ring = ep->iso_ring;
+  if (!ring) {
+    return;
+  }
+  iso_stats_begin(ring);
+  ring->stats.disconnected |= disconnected;
+  iso_stats_end(ring);
+  ep->iso_ring = NULL;
+  __dmb();
+  // Final access to ring. Core0 may free it as soon as this store is visible.
+  ring->active = false;
+}
+
+static void __no_inline_not_in_flash_func(iso_ring_write)(pio_usb_iso_ring_t *ring,
+                                                         const uint8_t *data, uint16_t len) {
+  uint32_t const written = ring->write_pos;
+  uint32_t const read = ring->read_pos;
+  __dmb();
+  uint32_t const used = written - read;
+  if (used > ring->capacity || len > ring->capacity - used) {
+    ring->stats.overrun_packets++;
+    ring->stats.overrun_bytes += len;
+    return;
+  }
+  uint32_t const offset = written & (ring->capacity - 1);
+  uint32_t first = ring->capacity - offset;
+  if (first > len) {
+    first = len;
+  }
+  if (first) {
+    memcpy(ring->buffer + offset, data, first);
+  }
+  if (len > first) {
+    memcpy(ring->buffer, data + first, len - first);
+  }
+  if (used + len > ring->stats.high_water_bytes) {
+    ring->stats.high_water_bytes = used + len;
+  }
+  __dmb(); // Publish only after the entire packet is stored.
+  ring->write_pos = written + len;
+}
