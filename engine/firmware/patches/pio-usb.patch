+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+// One core1 producer and one core0 consumer. Both this object and storage MUST
+// reside in internal SRAM. The caller retains ownership until stop succeeds.
+// Counters are unsigned 32-bit totals, with normal modulo-2^32 wrap semantics.
+typedef struct {
+  uint32_t polls;
+  uint32_t packets;
+  uint32_t bytes;
+  uint32_t zero_packets;
+  uint32_t error_packets;
+  uint32_t overrun_packets;
+  uint32_t overrun_bytes;
+  uint32_t unarmed_frames;
+  uint32_t active_frames;
+  uint32_t total_transaction_us;
+  uint32_t max_transaction_us;
+  uint32_t max_poll_gap_us;
+  uint32_t high_water_bytes;
+  uint32_t max_frame_us;
+  uint32_t frame_overruns;
+  uint32_t available_bytes;
+  uint32_t active;
+  uint32_t disconnected;
+} pio_usb_iso_stats_t;
+
+typedef struct pio_usb_iso_ring {
+  uint8_t *buffer;
+  uint32_t capacity;
+  volatile uint32_t write_pos;
+  volatile uint32_t read_pos;
+  volatile uint32_t stats_seq;
+  volatile bool active;
+  volatile bool stop_requested;
+  uint16_t interval_frames;
+  uint32_t last_poll_us;
+  pio_usb_iso_stats_t stats;
+} pio_usb_iso_ring_t;
+
+// Endpoint must already be open, idle, full-speed isochronous IN. Zero override
+// uses the descriptor interval. UAC full-speed callers may explicitly select 1.
+bool pio_usb_host_iso_start(uint8_t root_idx, uint8_t device_address,
+                           uint8_t ep_address, pio_usb_iso_ring_t *ring,
+                           uint8_t *storage, uint32_t capacity,
+                           uint16_t interval_override_frames);
+// Returns bytes copied, never blocks. A full ring drops the newest whole USB
+// packet and increments overrun counters; it never manufactures silence.
+uint32_t pio_usb_host_iso_read(pio_usb_iso_ring_t *ring, uint8_t *dest, uint32_t len);
+// Returns true only after core1 has detached and no longer references ring or
+// storage. On timeout, the caller MUST retain both allocations and retry later.
+bool pio_usb_host_iso_stop(pio_usb_iso_ring_t *ring, uint32_t timeout_us);
+// Consistent core1 counter snapshot; available_bytes is a concurrent estimate.
+bool pio_usb_host_iso_stats(pio_usb_iso_ring_t *ring, pio_usb_iso_stats_t *out);
